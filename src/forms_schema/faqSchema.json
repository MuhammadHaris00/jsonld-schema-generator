{
  "title": "FAQ Schema Generator",
  "description": "Add frequently asked questions to generate FAQPage structured data.",
  "type": "object",
  "properties": {
    "faqs": {
      "type": "array",
      "title": "FAQs",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        }
      }
    }
  }
}

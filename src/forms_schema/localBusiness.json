{
  "type": "object",
  "required": [
    "businessName",
    "businessType"
  ],
  "properties": {
    "name": {
      "type": "string",
      "title": "Business Name"
    },
    "businessType": {
      "type": "string",
      "title": "Business Type",
      "enum": [
        "General Local Business",
        "Auto Repair",
        "Dentist",
        "Dry Cleaning Or Laundry",
        "Electrician Contractor",
        "General Contractor",
        "H V A C Business",
        "House Painter",
        "Locksmith",
        "Plumber",
        "Roofing Contractor",
        "Real Estate Agent",
        "Attorney",
        "Accounting Service",
        "Financial Service",
        "Medical Clinic",
        "Veterinary Care"
      ]
    },
    "streetAddress": {
      "type": "string",
      "title": "Street Address"
    },
    "addressLocality": {
      "type": "string",
      "title": "City"
    },
    "addressRegion": {
      "type": "string",
      "title": "State"
    },
    "postalCode": {
      "type": "string",
      "title": "Postal Code"
    },
    "telephone": {
      "type": "string",
      "title": "Phone Number"
    },
    "url": {
      "type": "string",
      "title": "Website URL",
      "format": "uri"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "priceRange": {
      "type": "string",
      "title": "Price Range",
      "enum": [
        "$ - Inexpensive",
        "$$ - Moderate",
        "$$$ - Expensive",
        "$$$$ - Very Expensive"
      ]
    },
    "description": {
      "type": "string",
      "title": "Business Description"
    },
    "openingHours": {
      "type": "string",
      "title": "Opening Hours"
    },
    "image": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "latitude": {
      "type": "number",
      "title": "Latitude (Optional)"
    },
    "longitude": {
      "type": "number",
      "title": "Longitude (Optional)"
    }
  }
}
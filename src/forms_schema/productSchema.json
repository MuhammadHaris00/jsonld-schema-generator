{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Product Name *"
    },
    "description": {
      "type": "string",
      "title": "Product Description *"
    },
    "brand": {
      "type": "string",
      "title": "Brand"
    },
    "model": {
      "type": "string",
      "title": "Model"
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "gtin": {
      "type": "string",
      "title": "GTIN/UPC"
    },
    "image": {
      "type": "string",
      "title": "Product Image URL",
      "format": "uri"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "price": {
      "type": "string",
      "title": "Price"
    },
    "priceCurrency": {
      "type": "string",
      "title": "Currency",
      "enum": ["USD", "EUR", "GBP", "CAD", "AUD"],
      "enumNames": ["USD ($)", "EUR (€)", "GBP (£)", "CAD", "AUD"]
    },
    "lowPrice": {
      "type": "string",
      "title": "Low Price (for price range)"
    },
    "highPrice": {
      "type": "string",
      "title": "High Price (for price range)"
    },
    "availability": {
      "type": "string",
      "title": "Availability",
      "enum": [
        "https://schema.org/InStock",
        "https://schema.org/OutOfStock",
        "https://schema.org/PreOrder",
        "https://schema.org/BackOrder"
      ],
      "enumNames": ["In Stock", "Out of Stock", "Pre Order", "Back Order"]
    },
    "itemCondition": {
      "type": "string",
      "title": "Condition",
      "enum": [
        "https://schema.org/NewCondition",
        "https://schema.org/UsedCondition",
        "https://schema.org/RefurbishedCondition",
        "https://schema.org/DamagedCondition"
      ],
      "enumNames": ["New", "Used", "Refurbished", "Damaged"]
    },
    "url": {
      "type": "string",
      "title": "Product Website",
      "format": "uri"
    },
    "seller": {
      "type": "string",
      "title": "Business/Seller Name"
    },
    "ratingValue": {
      "type": "string",
      "title": "Rating Value (1-5)"
    },
    "reviewCount": {
      "type": "string",
      "title": "Review Count"
    },
    "priceValidUntil": {
      "type": "string",
      "title": "Offer Valid Until",
      "format": "date"
    }
  },
  "required": ["name", "description"]
}

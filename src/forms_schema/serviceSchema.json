{
  "type": "object",
  "title": "Service Information",
  "properties": {
    "name": {
      "type": "string",
      "title": "Service Name *"
    },
    "serviceType": {
      "type": "string",
      "title": "Service Type *",
      "enum": [
        "Service",
        "ProfessionalService",
        "FinancialService",
        "GovernmentService",
        "TaxiService",
        "BroadcastService",
        "CableOrSatelliteService",
        "FoodService"
      ]
    },
    "description": {
      "type": "string",
      "title": "Service Description *"
    },
    "provider": {
      "type": "string",
      "title": "Service Provider"
    },
    "brand": {
      "type": "string",
      "title": "Brand"
    },
    "areaServed": {
      "type": "string",
      "title": "Area Served"
    },
    "url": {
      "type": "string",
      "title": "Service URL",
      "format": "uri"
    },
    "image": {
      "type": "string",
      "title": "Service Image URL",
      "format": "uri"
    },
    "category": {
      "type": "string",
      "title": "Service Category"
    },
    "audience": {
      "type": "string",
      "title": "Target Audience",
      "enum": ["Business (B2B)", "Consumer (B2C)", "Both B2B & B2C"]
    },
    "serviceOutput": {
      "type": "string",
      "title": "Service Output"
    },
    "hoursAvailable": {
      "type": "string",
      "title": "Hours Available"
    },
    "price": {
      "type": "string",
      "title": "Price"
    },
    "priceCurrency": {
      "type": "string",
      "title": "Currency"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "ratingValue": {
      "type": "string",
      "title": "Rating Value (1-5)"
    },
    "reviewCount": {
      "type": "string",
      "title": "Review Count"
    },
    "termsOfService": {
      "type": "string",
      "title": "Terms of Service URL",
      "format": "uri"
    }
  },
  "required": ["name", "serviceType", "description"]
}
